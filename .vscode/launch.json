{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Editor",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/linux-debug/editor/bin/editor",
            "cwd": "${workspaceFolder}/out/build/linux-debug/editor/bin",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Launch Game",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/linux-debug/v/bin/v",
            "cwd": "${workspaceFolder}/out/build/linux-debug/v/bin",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
